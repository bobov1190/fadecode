# Ключ OpenRouter: https://openrouter.ai/keys  (никому не показывай и не коммить)
OPENROUTER_API_KEY=

# Модели по порядку: если первая не ответила, пробуется следующая.
# Актуальные бесплатные модели: list_models.bat
AI_MODELS=openrouter/free

# Дневные лимиты ИИ-запросов (у бесплатного OpenRouter 50 в день на аккаунт)
AI_DAILY_GLOBAL=45
AI_DAILY_USER=30

# Необязательно
# PORT=5000
# SECRET_KEY=   (если пусто, создаётся instance/secret.key)

# ???? ??????: ?????? ??????????? Neon (Connect -> Connection string, ????? ? pooler).
# ????? = ????????? SQLite-???? instance/fadecode.db
DATABASE_URL=
# DB_POOL_MAX=5

# ????? ?? Postgres (?????????????): ????????? ?????, ????????? ? ????????? ????
# TEST_DATABASE_URL=

# AiMaker (генерация карточек в редакторе); по умолчанию Nemotron 3 Ultra, Laguna S 2.1, Inkling, Nemotron 3 Super
# AIMAKER_MODELS=
# AIMAKER_DAILY=10
